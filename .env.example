# NIMR SAV PRO
# Optional public URL used by deployment scripts or integrations.
APP_URL="http://localhost:3000/NIMR-SAV-PRO/"

# Backend v2 public frontend variables.
# Leave empty for local-only mode.
VITE_BACKEND_MODE=local-only
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Forbidden in Vite/frontend:
# SUPABASE_SERVICE_ROLE_KEY
# GOOGLE_CLIENT_SECRET
# GOOGLE_SERVICE_ACCOUNT_JSON
# GOOGLE_REFRESH_TOKEN
# GOOGLE_PRIVATE_KEY
